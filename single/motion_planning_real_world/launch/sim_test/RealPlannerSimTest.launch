<launch>
  <!-- Real-world planners in the MRS simulator, through mrs_sim_bridge.py instead of mavros -->

  <!-- Planner (aep | rhnbvp | kaep | krhnbvp) -->
  <arg name="planner" default="aep" />
  <arg name="name" default="$(eval {'aep':'AEP_rw','rhnbvp':'RH_NBVP_rw','kaep':'KAEP_rw','krhnbvp':'KRH_NBVP_rw'}[arg('planner')])" />
  <arg name="aep_family" default="$(eval arg('planner') in ('aep','kaep'))" />
  <arg name="kinodynamic" default="$(eval arg('planner') in ('kaep','krhnbvp'))" />

  <!-- Map -->
  <arg name="voxel_size" default="$(optenv VOXEL_SIZE 0.2)" />
  <arg name="voxels_per_side" default="$(optenv VOXELS_PER_SIDE 16)" />

  <!-- UAV -->
  <arg name="UAV_NAME" default="$(optenv UAV_NAME uav1)" />

  <group ns="$(arg UAV_NAME)">
    <!-- Bridge -->
    <node pkg="motion_planning_real_world" type="mrs_sim_bridge.py" name="mrs_sim_bridge" output="screen">
      <param name="frame_id" value="$(arg UAV_NAME)/world_origin" />
      <remap from="~uav_state_in" to="estimation_manager/uav_state" />
      <remap from="~pose_out" to="bridge/local_pose" />
      <remap from="~velocity_out" to="bridge/velocity" />
      <remap from="~setpoint_in" to="bridge/setpoint" />
      <remap from="~reference_out" to="control_manager/reference" />
    </node>

    <node pkg="motion_planning_real_world" type="$(arg name)" name="planner_node" output="screen">
      <!-- Configuration, school boxes relative to the spawn -->
      <rosparam file="$(find motion_planning_real_world)/config/GainConfig_rw.yaml" />
      <rosparam file="$(find motion_planning_real_world)/config/$(arg name).yaml" />
      <rosparam file="$(find motion_planning_real_world)/config/sim_test.yaml" />
      <param name="uav_namespace" value="$(arg UAV_NAME)" />

      <!-- Simulator Frames -->
      <param name="frame_id" value="$(arg UAV_NAME)/world_origin" />
      <param name="body/frame_id" value="$(arg UAV_NAME)/fcu" />
      <param name="camera/frame_id" value="$(arg UAV_NAME)/rgbd_front_pitched/aligned_depth_to_color" />

      <!-- Voxblox -->
      <remap from="~esdf_map_in" to="voxblox_node/esdf_map_out" />
      <remap from="~tsdf_map_in" to="voxblox_node/tsdf_map_out" />
      <param name="use_tf_transforms" value="false" />
      <param name="tsdf_voxel_size" value="$(arg voxel_size)" />
      <param name="tsdf_voxels_per_side" value="$(arg voxels_per_side)" />
      <param name="update_mesh_every_n_sec" value="0.0" />
      <param name="publish_traversable" value="false" />

      <!-- Publishers -->
      <remap from="~visualization_marker_out" to="visualization_marker_out" />
      <remap from="~simulation_ready" to="simulation_ready" />
      <remap from="~tree_node_out" to="tree_node" if="$(arg aep_family)" />
      <remap from="~frustum_out" to="frustum_out" />
      <remap from="~unknown_voxels_out" to="unknown_voxels_out" />
      <remap from="~offset_out" to="offset_out" />

      <!-- Subscribers -->
      <remap from="~local_pose_in" to="bridge/local_pose" />
      <remap from="~velocity_in" to="bridge/velocity" unless="$(arg kinodynamic)" />
      <remap from="~local_velocity_in" to="bridge/velocity" if="$(arg kinodynamic)" />

      <!-- Service Clients -->
      <remap from="~setpoint_out" to="bridge/setpoint" />
      <remap from="~best_node_out" to="cache_nodes/best_node" if="$(arg aep_family)" />

      <!-- Service Servers -->
      <remap from="~start_in" to="~start" />
      <remap from="~stop_in" to="~stop" />
      <remap from="~offset_in" to="~offset" />
    </node>
  </group>
</launch>

<launch>
  <!-- Stage 1 recorder. It never starts the planner; its clock begins on offset_out. -->
  <arg name="record_data" default="true"/>
  <arg name="data_directory" default="$(env HOME)/real_experiments/current"/>
  <arg name="data_frequency" default="5.0" />
  <arg name="time_limit" default="10" />
  <arg name="early_stop" default="true" />
  <arg name="early_stop_grace" default="10.0" />
  <arg name="startup_timeout" default="90.0" />

  <arg name="UAV_NAME" default="$(optenv UAV_NAME uav1)" />

  <group ns="$(arg UAV_NAME)">

    <!-- Experiment recorder -->
    <node name="eval_data_node" pkg="motion_planning_real_world" type="eval_data_node_real.py" output="screen" required="true">
      <remap from="points" to="/$(arg UAV_NAME)/rgbd_front_pitched/aligned_depth_to_color/points" />
      <remap from="simulation_ready" to="simulation_ready" />
      <remap from="offset_in" to="offset_out" />
      <param name="ns_planner" value="planner_node" />
      <param name="ns_voxblox" value="voxblox_node" />
      <param name="startup_timeout" value="$(arg startup_timeout)" />
      <param name="evaluate" value="$(arg record_data)" />
      <param name="eval_directory" value="$(arg data_directory)" />
      <param name="eval_frequency" value="$(arg data_frequency)" />
      <param name="time_limit" value="$(arg time_limit)" />
      <param name="early_stop" value="$(arg early_stop)" />
      <param name="early_stop_grace" value="$(arg early_stop_grace)" />
    </node>
  </group>

</launch>

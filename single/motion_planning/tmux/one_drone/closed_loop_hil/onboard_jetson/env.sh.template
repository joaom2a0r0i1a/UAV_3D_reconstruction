# Template for the Jetson's ~/hil_env.sh (the closed-loop-HIL ROS env).
# Copy to the Jetson home and edit the master IP for your desktop:
#   scp env.sh.template <user>@<jetson-ip>:~/hil_env.sh
# stack.sh and run_config.sh source ~/hil_env.sh (NOT this repo copy).
export ROS_MASTER_URI=http://<desktop-lan-ip>:11311   # <- the DESKTOP's LAN IP (roscore host)
export ROS_IP=$(hostname -I | awk '{print $1}')     # this Jetson's first LAN IP
export ROS_HOSTNAME=$ROS_IP

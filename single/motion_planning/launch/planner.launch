<launch>
  <!-- Planner (aep | rhnbvp | kaep | krhnbvp) -->
  <arg name="planner" default="aep" />
  <arg name="name" default="$(eval {'aep':'AEP','rhnbvp':'RH_NBVP','kaep':'KAEP','krhnbvp':'KRH_NBVP'}[arg('planner')])" />
  <arg name="aep_family" default="$(eval arg('planner') in ('aep','kaep'))" />
  <arg name="kinodynamic" default="$(eval arg('planner') in ('kaep','krhnbvp'))" />
  <arg name="sweepable" default="$(eval arg('planner') in ('aep','rhnbvp'))" />

  <!-- Experiment Sweep -->
  <arg name="marginal_gain"   default="$(eval optenv('AEP_MARGINAL_GAIN', 'true' if arg('planner')=='aep' else 'false'))" />
  <arg name="compute"         default="$(optenv AEP_COMPUTE gpu)" />
  <arg name="marginal_split"  default="$(optenv AEP_MARGINAL_SPLIT false)" />
  <arg name="benchmark"       default="$(optenv AEP_BENCHMARK false)" />
  <arg name="benchmark_suite" default="$(optenv AEP_BENCH_SUITE timing)" />

  <!-- Environment and Parameter Overrides -->
  <arg name="env" default="$(optenv PLANNER_ENV)" />
  <arg name="overrides" default="$(optenv PLANNER_OVERRIDES)" />

  <!-- Map -->
  <arg name="voxel_size" default="$(optenv VOXEL_SIZE 0.2)" />
  <arg name="voxels_per_side" default="$(optenv VOXELS_PER_SIDE 16)" />

  <!-- UAV -->
  <arg name="UAV_NAME" default="$(optenv UAV_NAME uav1)" />

  <group ns="$(arg UAV_NAME)">
    <node pkg="motion_planning" type="$(arg name)" name="planner_node" output="screen">
      <!-- Configuration -->
      <rosparam file="$(find gain_evaluation)/config/GainConfig.yaml" />
      <rosparam file="$(find motion_planning)/config/$(arg name).yaml" />
      <rosparam file="$(arg overrides)" if="$(eval arg('overrides') != '')" />
      <param name="environment" value="$(arg env)" if="$(eval arg('env') != '')" />
      <param name="uav_namespace" value="$(arg UAV_NAME)" />

      <!-- Experiment Sweep -->
      <param name="evaluation/marginal_gain"  value="$(arg marginal_gain)"   if="$(arg sweepable)" />
      <param name="evaluation/compute"        value="$(arg compute)"         if="$(arg sweepable)" />
      <param name="evaluation/marginal_split" value="$(arg marginal_split)"  if="$(arg sweepable)" />
      <param name="benchmark/enabled"         value="$(arg benchmark)"       if="$(arg sweepable)" />
      <param name="benchmark/suite"           value="$(arg benchmark_suite)" if="$(arg sweepable)" />

      <!-- Voxblox -->
      <remap from="~esdf_map_in" to="voxblox_node/esdf_map_out" />
      <remap from="~tsdf_map_in" to="voxblox_node/tsdf_map_out" />
      <param name="use_tf_transforms" value="false" />
      <param name="tsdf_voxel_size" value="$(arg voxel_size)" />
      <param name="tsdf_voxels_per_side" value="$(arg voxels_per_side)" />
      <param name="update_mesh_every_n_sec" value="0.0" />
      <param name="publish_traversable" value="false" />

      <!-- Publishers -->
      <remap from="~visualization_marker_out" to="visualization_marker_out" />
      <remap from="~initial_reference_out" to="control_manager/reference" />
      <remap from="~simulation_ready" to="simulation_ready" />
      <remap from="~reference_out" to="reference_out" />
      <remap from="~tree_node_out" to="tree_node" if="$(arg aep_family)" />
      <remap from="~frustum_out" to="frustum_out" />
      <remap from="~unknown_voxels_out" to="unknown_voxels_out" />

      <!-- Subscribers -->
      <remap from="~uav_state_in" to="estimation_manager/uav_state" />
      <remap from="~control_manager_diag_in" to="control_manager/diagnostics" />

      <!-- Service Clients -->
      <remap from="~trajectory_reference_out" to="control_manager/trajectory_reference" if="$(arg kinodynamic)" />
      <remap from="~best_node_out" to="cache_nodes/best_node" if="$(arg aep_family)" />

      <!-- Service Servers -->
      <remap from="~start_in" to="~start" />
      <remap from="~stop_in" to="~stop" />
    </node>
  </group>
</launch>
